{
	"name": "@dedalus-labs/hollywood",
	"version": "0.0.3",
	"private": false,
	"description": "Generate and test GitHub Actions with typed TypeScript.",
	"keywords": [
		"actions",
		"agents",
		"ai",
		"automation",
		"ci",
		"ci-cd",
		"devops",
		"gitops",
		"github",
		"github-actions",
		"llms",
		"local-testing",
		"typed-actions",
		"typescript",
		"workflow",
		"workflows",
		"yaml"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dedalus-labs/hollywood.git"
	},
	"bugs": {
		"url": "https://github.com/dedalus-labs/hollywood/issues"
	},
	"homepage": "https://oss.dedaluslabs.ai/hollywood",
	"bin": {
		"hollywood": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./action-runtime": {
			"types": "./dist/action-runtime.d.ts",
			"import": "./dist/action-runtime.js"
		},
		"./environments": {
			"types": "./dist/environments.d.ts",
			"import": "./dist/environments.js"
		},
		"./expr": {
			"types": "./dist/expr.d.ts",
			"import": "./dist/expr.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"actions": "npm exec -- hollywood build",
		"check": "npm run build && node dist/cli.js check",
		"generate": "node dist/cli.js generate",
		"lint": "oxlint --vitest-plugin --import-plugin --deny-warnings . --ignore-pattern dist --ignore-pattern node_modules --ignore-pattern .github",
		"package": "npm run build && npm pack --dry-run",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsgo --noEmit"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@actions/core": "3.0.1",
		"@actions/exec": "3.0.0",
		"@actions/expressions": "0.3.61",
		"@actions/workflow-parser": "0.3.61",
		"@octokit/openapi-types": "28.0.0",
		"esbuild": "0.28.1",
		"yaml": "2.8.4",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "14.0.0",
		"@types/node": "^26.2.0",
		"@typescript/native-preview": "7.0.0-dev.20260514.1",
		"commander": "14.0.3",
		"oxlint": "^1.70.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tinyglobby": "0.2.17",
		"tsdown": "0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "npm@11.13.0"
}
